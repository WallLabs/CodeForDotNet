<?xml version="1.0" encoding="utf-8"?>
<Project>

    <!-- Global Properties -->
    <PropertyGroup>
        <!-- Define SolutionDir variable to support solution relative paths and ensure MSBuild operates the same as within Visual Studio. -->
        <SolutionDir>$(MSBuildThisFileDirectory)</SolutionDir>
    </PropertyGroup>

    <!-- Common Properties -->
    <PropertyGroup>
        
        <!-- Identity -->
        <Product>Code for .NET</Product>
        <Authors>Wall Labs</Authors>
        <Company>Wall Labs</Company>
        <Copyright>Copyright © Wall Labs. All Rights Reserved.</Copyright>
        <AssemblyCopyright>Copyright © Wall Labs.</AssemblyCopyright>
        <AssemblyTrademark>All Rights Reserved.</AssemblyTrademark>
        <Version>10.0.2603.5002</Version>
        <AssemblyVersion>10.0.2603.5002</AssemblyVersion>
        <FileVersion>10.0.2603.5002</FileVersion>
        
        <!-- Language -->
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NeutralLanguage>en-US</NeutralLanguage>
        <DefaultLanguage>en-US</DefaultLanguage>
        
        <!-- Compilation -->
        <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>$(SolutionDir)Common\Code for .NET.snk</AssemblyOriginatorKeyFile>
        
        <!-- Warnings -->
        <WarningLevel>9999</WarningLevel>
        <WarningsAsErrors />
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        
        <!-- Code Analysis -->
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisMode>all</AnalysisMode>
        <AnalysisLevel>latest-Recommended</AnalysisLevel>
        <CodeAnalysisIgnoreGeneratedCode>true</CodeAnalysisIgnoreGeneratedCode>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        
        <!-- Packaging -->
        <IsPackable>false</IsPackable>
        <PackageProjectUrl>http://wall-labs.com/Links/CodeForDotNet</PackageProjectUrl>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        
    </PropertyGroup>
    
    <!-- Configuration Specific Properties -->
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <DebugType>full</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <DefineConstants>DEBUG</DefineConstants>
        <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>
    
</Project>
